<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>✨ My Super Cute Space ✨</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header / Navigation -->
    <header>
        <nav class="container">
            <h1 class="logo">🌸 CuteSite</h1>
            <ul class="nav-links">
                <li><a href="#hero">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="container">
        <div class="hero-content">
            <span class="badge">Welcome friend! 💖</span>
            <h2>Make Life Pretty in Pink</h2>
            <p>A magical little corner of the internet hosted on GitHub Pages.</p>
            <button id="cta-btn">Click for Magic! ✨</button>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="container">
        <div class="card">
            <h3>About This Project 🎀</h3>
            <p>Filled with soft pastels, rounded edges, and cozy vibes. This template is ready for you to customize and share with the world!</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>Made with 💖 and lots of pink &copy; 2026</p>
        </div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
